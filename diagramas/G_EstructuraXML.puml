@startuml
title Estructura del Recibo XML — La Casa del Perfume\n(CFDI 3.3 generado por CarritoService.descargarReciboXML())

top to bottom direction

skinparam class {
  BackgroundColor #EEF4FF
  BorderColor #3A6BC9
  FontColor #1A1A2E
}

skinparam ArrowColor #3A6BC9
skinparam backgroundColor #FAFAFA

class "<cfdi:Comprobante>" as ROOT {
  (Raíz del documento — CFDI 3.3 SAT)
  --
  xmlns:cfdi = "http://www.sat.gob.mx/cfd/3"
  Version     = "3.3"
  Serie       = "A"
  Folio       : string  [ej: ORD-1777507322236]
  Fecha       : dateTime ISO 8601  [ej: 2026-05-11T14:30:00]
  FormaPago   = "03"    [transferencia electrónica]
  SubTotal    : decimal [2 decimales, sin IVA]
  Moneda      = "MXN"
  Total       : decimal [2 decimales, con IVA]
  TipoDeComprobante = "I"  [Ingreso]
  MetodoPago  = "PUE"
  LugarExpedicion = "44100"
  Exportacion = "01"
  --
  Generado por: CarritoService.descargarReciboXML(folio, paypalOrderId)
  También generado y enviado como adjunto por: EmailPedidoService
  Descarga automática como: CFDI-{folio}.xml
}

class "<cfdi:Emisor>" as EMISOR {
  Rfc           = "EKU9003173C9"
  Nombre        = "LA CASA DEL PERFUME SA DE CV"
  RegimenFiscal = "601"
}

class "<cfdi:Receptor>" as RECEPTOR {
  Rfc                    : string  [User.rfc o "XAXX010101000"]
  Nombre                 : string  [User.nombre + apellido o "PÚBLICO EN GENERAL"]
  DomicilioFiscalReceptor = "44100"
  RegimenFiscalReceptor  : string  [User.regimenFiscal o "616"]
  UsoCFDI                : string  [User.usoCfdi o "G03"]
}

class "<cfdi:Conceptos>" as CONCEPTOS {
  Contenedor de 1 a N <cfdi:Concepto>
}

class "<cfdi:Concepto>" as CONCEPTO {
  ClaveProdServ = "53101700"
  Cantidad      : integer  [unidades del item]
  ClaveUnidad   = "H87"   [Pieza]
  Unidad        = "Pieza"
  Descripcion   : string   [product.name, XML-escaped]
  ValorUnitario : decimal  [6 decimales]
  Importe       : decimal  [Cantidad × ValorUnitario]
  --
  <cfdi:Impuestos>
    <cfdi:Traslados>
      <cfdi:Traslado Impuesto="002" TipoFactor="Tasa"
                     TasaOCuota="0.160000"
                     Importe: decimal [IVA del concepto, 6 dec]/>
}

class "<cfdi:Impuestos>" as IMPUESTOS {
  (A nivel raíz del Comprobante)
  --
  TotalImpuestosTrasladados : decimal [IVA total, 6 decimales]
  --
  <cfdi:Traslados>
    <cfdi:Traslado
      Base          : decimal [SubTotal, 2 dec]
      Impuesto      = "002"   [IVA]
      TipoFactor    = "Tasa"
      TasaOCuota    = "0.160000"
      Importe       : decimal [IVA total, 6 dec]/>
}

' Jerarquía del documento
ROOT "1" *-- "1" EMISOR    : <cfdi:Emisor>
ROOT "1" *-- "1" RECEPTOR  : <cfdi:Receptor>
ROOT "1" *-- "1" CONCEPTOS : <cfdi:Conceptos>
ROOT "1" *-- "1" IMPUESTOS : <cfdi:Impuestos>
CONCEPTOS "1" *-- "1..*" CONCEPTO : <cfdi:Concepto> (1 o más)


@enduml
